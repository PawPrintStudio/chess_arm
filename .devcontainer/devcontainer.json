{
    "name": "chess-arm",
    "build": {
        "dockerfile": "Dockerfile",
        // Raspberry Pi 5: export ROS_BASE_IMAGE=ros:humble-ros-base first.
        "args": {
            "BASE_IMAGE": "${localEnv:ROS_BASE_IMAGE}"
        }
    },
    "remoteUser": "ros",
    // --network=host: ROS 2 discovery (multicast) and direct reach to the
    //   robot work without port juggling (Linux/WSL2).
    // --ipc=host: DDS shared-memory transport between host and container.
    // ptrace/seccomp: let gdb attach inside the container.
    // The ZED is a plain UVC camera. The cgroup rule (81 = V4L2) plus the
    //   /dev bind below let any camera plugged in, or renumbered after a
    //   replug, appear inside. `--device /dev/videoN` would refuse to start
    //   the container whenever that node is missing. The video group
    //   (gid 44 on host and image) grants the file access.
    "runArgs": [
        "--network=host",
        "--ipc=host",
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined",
        "--device-cgroup-rule=c 81:* rmw",
        "--group-add=video"
    ],
    // GUI (RViz) via the host X server. On Linux run `xhost +local:` once
    // per session; on Windows, WSLg provides DISPLAY=:0 automatically.
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_X11_NO_MITSHM": "1",
        // Which arm: the scripts and launch files read these. chess_env.sh
        // overrides them with the chess arm's addresses (192.168.1.x).
        "ROBOT_IP": "${localEnv:ROBOT_IP:192.168.56.101}",
        "LAPTOP_IP": "${localEnv:LAPTOP_IP:192.168.56.1}",
        "RG2_SERIAL": "${localEnv:RG2_SERIAL:1000042561}"
    },
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        "source=/dev,target=/dev,type=bind"
    ],
    // Vendor import first (scripts/vendor_import.sh, ur7e.repos): pulls the
    // third-party UR+RG2 packages into src/vendor/ (gitignored) so rosdep
    // below sees their package.xml files. Then rosdep at create time:
    // dependencies come from every package.xml under src/, the same source
    // of truth CI uses.
    "postCreateCommand": "bash scripts/vendor_import.sh && sudo apt-get update && rosdep update && rosdep install --from-paths src --ignore-src -y",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
